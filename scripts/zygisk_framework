#!/system/bin/sh

set -u
umask 022
LC_ALL=C
export LC_ALL

BASE_DIR=/data/adb/zygisk_framework
MODULES_DIR="$BASE_DIR/modules"
DATA_DIR="$BASE_DIR/data"
LOCK_DIR="$BASE_DIR/.cli-lock"
BUSYBOX=
LOCK_HELD=0
STAGE_DIR=
BACKUP_DIR=
INSTALL_TARGET=
SCOPE_TEMP_FILE=
SCOPE_NEXT_FILE=
PREF_TEMP_FILE=

fail() {
  printf 'zygisk_framework: %s\n' "$*" >&2
  exit 1
}

cleanup() {
  if [ -n "$STAGE_DIR" ] && [ -d "$STAGE_DIR" ]; then
    "$BUSYBOX" rm -rf "$STAGE_DIR"
  fi
  if [ -n "$BACKUP_DIR" ] && [ -d "$BACKUP_DIR" ]; then
    if [ -n "$INSTALL_TARGET" ] && [ ! -e "$INSTALL_TARGET" ]; then
      "$BUSYBOX" mv "$BACKUP_DIR" "$INSTALL_TARGET" 2>/dev/null || true
    else
      "$BUSYBOX" rm -rf "$BACKUP_DIR"
    fi
  fi
  if [ -n "$SCOPE_TEMP_FILE" ] && [ -f "$SCOPE_TEMP_FILE" ]; then
    "$BUSYBOX" rm -f "$SCOPE_TEMP_FILE"
  fi
  if [ -n "$SCOPE_NEXT_FILE" ] && [ -f "$SCOPE_NEXT_FILE" ]; then
    "$BUSYBOX" rm -f "$SCOPE_NEXT_FILE"
  fi
  if [ -n "$PREF_TEMP_FILE" ] && [ -f "$PREF_TEMP_FILE" ]; then
    "$BUSYBOX" rm -f "$PREF_TEMP_FILE"
  fi
  if [ "$LOCK_HELD" -eq 1 ]; then
    "$BUSYBOX" rmdir "$LOCK_DIR" 2>/dev/null || true
  fi
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

usage() {
  cat <<'EOF'
Usage:
  zygisk_framework install <module.zip> [--force]
  zygisk_framework list
  zygisk_framework info <module-id>
  zygisk_framework scope <module-id> list
  zygisk_framework scope <module-id> add <target> [target...]
  zygisk_framework scope <module-id> remove <target> [target...]
  zygisk_framework scope <module-id> set <target> [target...]
  zygisk_framework scope <module-id> clear
  zygisk_framework prefs <module-id> <group> list
  zygisk_framework prefs <module-id> <group> get <key>
  zygisk_framework prefs <module-id> <group> set <key> string <value>
  zygisk_framework prefs <module-id> <group> set <key> string-set [value...]
  zygisk_framework prefs <module-id> <group> set <key> int|long|float|boolean <value>
  zygisk_framework prefs <module-id> <group> remove <key>
  zygisk_framework prefs <module-id> <group> clear
  zygisk_framework remove <module-id>
  zygisk_framework enable <module-id>
  zygisk_framework disable <module-id>
  zygisk_framework version
  zygisk_framework help

Module changes apply to newly started processes. Running apps are not stopped.
EOF
}

if [ "$(id -u 2>/dev/null || printf 1)" != 0 ]; then
  fail "must be run as root"
fi

if [ -x /data/adb/ksu/bin/busybox ]; then
  BUSYBOX=/data/adb/ksu/bin/busybox
elif [ -x /data/adb/magisk/busybox ]; then
  BUSYBOX=/data/adb/magisk/busybox
else
  fail "Magisk or KernelSU BusyBox was not found"
fi

mkdir -p "$MODULES_DIR" "$DATA_DIR" || fail "cannot access framework data directories"
chmod 0700 "$DATA_DIR" || fail "cannot secure $DATA_DIR"

is_valid_id() {
  case "$1" in
    [A-Za-z]*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    *[!A-Za-z0-9._-]*) return 1 ;;
  esac
  [ "${#1}" -le 128 ]
}

get_prop() {
  "$BUSYBOX" awk -v key="$2" '
    function trim(value) {
      sub(/^[ \t\r]+/, "", value)
      sub(/[ \t\r]+$/, "", value)
      return value
    }
    {
      line = $0
      sub(/\r$/, "", line)
      if (line ~ /^[ \t]*#/ || line ~ /^[ \t]*$/) next
      separator = index(line, "=")
      if (separator == 0) next
      name = trim(substr(line, 1, separator - 1))
      if (name == key) {
        count++
        value = trim(substr(line, separator + 1))
      }
    }
    END {
      if (count != 1) exit 1
      print value
    }
  ' "$1"
}

is_positive_int() {
  case "$1" in
    ''|*[!0-9]*|0*) return 1 ;;
  esac
  [ "${#1}" -le 10 ] || return 1
  [ "$1" -le 2147483647 ] 2>/dev/null
}

is_valid_scope_line() {
  [ "${#1}" -le 512 ] \
    && printf '%s\n' "$1" | "$BUSYBOX" grep -Eq '^[A-Za-z0-9_][A-Za-z0-9_.:$-]*$'
}

trim_line() {
  printf '%s\n' "$1" | "$BUSYBOX" sed 's/\r$//; s/^[[:space:]]*//; s/[[:space:]]*$//'
}

is_valid_class_line() {
  printf '%s\n' "$1" | "$BUSYBOX" grep -Eq '^[A-Za-z_$][A-Za-z0-9_$]*(\.[A-Za-z_$][A-Za-z0-9_$]*)*$'
}

acquire_lock() {
  attempt=0
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 30 ]; then
      fail "another module operation holds the lock: $LOCK_DIR"
    fi
    "$BUSYBOX" sleep 1
  done
  LOCK_HELD=1
}

read_installed_id() {
  is_valid_id "$1" || fail "invalid module id: $1"
  [ -d "$MODULES_DIR/$1" ] && [ ! -L "$MODULES_DIR/$1" ] || fail "module is not installed or unsafe: $1"
}

checksum_status() {
  dir=$1
  [ -s "$dir/module.dex" ] && [ -s "$dir/module.sha256" ] || {
    printf 'INVALID (missing DEX or checksum)'
    return
  }
  expected=$("$BUSYBOX" awk 'NR == 1 { print $1; exit }' "$dir/module.sha256")
  case "$expected" in
    ''|*[!0123456789abcdefABCDEF]*) printf 'INVALID (malformed checksum)'; return ;;
  esac
  [ "${#expected}" -eq 64 ] || {
    printf 'INVALID (malformed checksum)'
    return
  }
  actual_line=$("$BUSYBOX" sha256sum "$dir/module.dex" 2>/dev/null) || {
    printf 'INVALID (cannot compute checksum)'
    return
  }
  actual=${actual_line%% *}
  if [ "$actual" = "$expected" ]; then
    printf 'OK'
  else
    printf 'INVALID (checksum mismatch)'
  fi
}

scope_has_target() {
  scope_path=$1
  requested_target=$2
  while IFS= read -r scope_line || [ -n "$scope_line" ]; do
    scope_line=$(trim_line "$scope_line")
    case "$scope_line" in ''|\#*) continue ;; esac
    [ "$scope_line" = "$requested_target" ] && return 0
  done < "$scope_path"
  return 1
}

validate_scope_file() {
  scope_path=$1
  while IFS= read -r scope_line || [ -n "$scope_line" ]; do
    scope_line=$(trim_line "$scope_line")
    case "$scope_line" in ''|\#*) continue ;; esac
    is_valid_scope_line "$scope_line" || fail "invalid existing scope target: $scope_line; use scope set or scope clear to repair it"
  done < "$scope_path"
}

normalize_scope_file() {
  scope_path=$1
  "$BUSYBOX" awk '
    function trim(value) {
      sub(/^[ \t\r]+/, "", value)
      sub(/[ \t\r]+$/, "", value)
      return value
    }
    {
      line = trim($0)
      if (line != "") print line
    }
  ' "$scope_path"
}

show_scope() {
  scope_path=$1
  found_scope=0
  while IFS= read -r scope_line || [ -n "$scope_line" ]; do
    scope_line=$(trim_line "$scope_line")
    case "$scope_line" in ''|\#*) continue ;; esac
    if is_valid_scope_line "$scope_line"; then
      printf '%s\n' "$scope_line"
    else
      printf '(invalid) %s\n' "$scope_line"
    fi
    found_scope=1
  done < "$scope_path"
  if [ "$found_scope" -eq 0 ]; then
    printf '(empty; module will not be injected into any process)\n'
  fi
}

manage_scope() {
  [ "$#" -ge 2 ] || fail "scope expects a module id and an operation"
  module_id=$1
  operation=$2
  shift 2
  is_valid_id "$module_id" || fail "invalid module id: $module_id"

  case "$operation" in
    list)
      [ "$#" -eq 0 ] || fail "scope $module_id list takes no targets"
      read_installed_id "$module_id"
      metadata_dir="$MODULES_DIR/$module_id/META-INF/xposed"
      [ -d "$metadata_dir" ] && [ ! -L "$metadata_dir" ] \
        || fail "module metadata directory is missing or unsafe: $module_id"
      scope_file="$metadata_dir/scope.list"
      [ -f "$scope_file" ] && [ ! -L "$scope_file" ] \
        || fail "module scope.list is missing or unsafe: $module_id"
      printf 'Scope for %s:\n' "$module_id"
      show_scope "$scope_file"
      ;;
    add|remove|set)
      [ "$#" -gt 0 ] || fail "scope $operation expects at least one target"
      for requested_target in "$@"; do
        is_valid_scope_line "$requested_target" || fail "invalid scope target: $requested_target"
      done
      acquire_lock
      read_installed_id "$module_id"
      metadata_dir="$MODULES_DIR/$module_id/META-INF/xposed"
      [ -d "$metadata_dir" ] && [ ! -L "$metadata_dir" ] \
        || fail "module metadata directory is missing or unsafe: $module_id"
      scope_file="$metadata_dir/scope.list"
      [ -f "$scope_file" ] && [ ! -L "$scope_file" ] \
        || fail "module scope.list is missing or unsafe: $module_id"
      if [ "$operation" != set ]; then
        validate_scope_file "$scope_file"
      fi
      scope_temp_candidate="$metadata_dir/.scope.list.tmp.$$"
      scope_next_candidate="$metadata_dir/.scope.list.next.$$"
      [ ! -e "$scope_temp_candidate" ] && [ ! -L "$scope_temp_candidate" ] \
        && [ ! -e "$scope_next_candidate" ] && [ ! -L "$scope_next_candidate" ] \
        || fail "temporary scope file already exists"
      SCOPE_TEMP_FILE=$scope_temp_candidate
      SCOPE_NEXT_FILE=$scope_next_candidate
      if [ "$operation" = set ]; then
        : > "$SCOPE_TEMP_FILE" || fail "cannot create temporary scope file"
      else
        normalize_scope_file "$scope_file" > "$SCOPE_TEMP_FILE" \
          || fail "cannot read current scope.list"
      fi

      for requested_target in "$@"; do
        case "$operation" in
          add)
            if scope_has_target "$SCOPE_TEMP_FILE" "$requested_target"; then
              printf 'Already in scope: %s\n' "$requested_target"
            else
              printf '%s\n' "$requested_target" >> "$SCOPE_TEMP_FILE" \
                || fail "cannot add scope target: $requested_target"
              printf 'Added scope target: %s\n' "$requested_target"
            fi
            ;;
          remove)
            if scope_has_target "$SCOPE_TEMP_FILE" "$requested_target"; then
              "$BUSYBOX" awk -v target="$requested_target" '
                function trim(value) {
                  sub(/^[ \t\r]+/, "", value)
                  sub(/[ \t\r]+$/, "", value)
                  return value
                }
                trim($0) != target { print }
              ' "$SCOPE_TEMP_FILE" > "$SCOPE_NEXT_FILE" \
                || fail "cannot remove scope target: $requested_target"
              "$BUSYBOX" mv "$SCOPE_NEXT_FILE" "$SCOPE_TEMP_FILE" \
                || fail "cannot update temporary scope file"
              SCOPE_NEXT_FILE="$metadata_dir/.scope.list.next.$$"
              printf 'Removed scope target: %s\n' "$requested_target"
            else
              printf 'Scope target not present: %s\n' "$requested_target"
            fi
            ;;
          set)
            if ! scope_has_target "$SCOPE_TEMP_FILE" "$requested_target"; then
              printf '%s\n' "$requested_target" >> "$SCOPE_TEMP_FILE" \
                || fail "cannot set scope target: $requested_target"
            fi
            ;;
        esac
      done

      "$BUSYBOX" chmod 0644 "$SCOPE_TEMP_FILE" || fail "cannot set scope.list permissions"
      "$BUSYBOX" mv "$SCOPE_TEMP_FILE" "$scope_file" \
        || fail "cannot atomically replace scope.list"
      SCOPE_TEMP_FILE=
      printf 'Scope updated for %s. Changes apply to newly started processes; running apps were not stopped.\n' "$module_id"
      ;;
    clear)
      [ "$#" -eq 0 ] || fail "scope $module_id clear takes no targets"
      acquire_lock
      read_installed_id "$module_id"
      metadata_dir="$MODULES_DIR/$module_id/META-INF/xposed"
      [ -d "$metadata_dir" ] && [ ! -L "$metadata_dir" ] \
        || fail "module metadata directory is missing or unsafe: $module_id"
      scope_file="$metadata_dir/scope.list"
      [ -f "$scope_file" ] && [ ! -L "$scope_file" ] \
        || fail "module scope.list is missing or unsafe: $module_id"
      scope_temp_candidate="$metadata_dir/.scope.list.tmp.$$"
      [ ! -e "$scope_temp_candidate" ] && [ ! -L "$scope_temp_candidate" ] \
        || fail "temporary scope file already exists"
      SCOPE_TEMP_FILE=$scope_temp_candidate
      : > "$SCOPE_TEMP_FILE" || fail "cannot create temporary scope file"
      "$BUSYBOX" chmod 0644 "$SCOPE_TEMP_FILE" || fail "cannot set scope.list permissions"
      "$BUSYBOX" mv "$SCOPE_TEMP_FILE" "$scope_file" \
        || fail "cannot atomically replace scope.list"
      SCOPE_TEMP_FILE=
      printf 'Cleared scope for %s; it will not be injected into any process. Changes apply to newly started processes.\n' "$module_id"
      ;;
    *)
      fail "unknown scope operation: $operation"
      ;;
  esac
}

byte_length() {
  printf '%s' "$1" | "$BUSYBOX" wc -c | "$BUSYBOX" tr -d ' '
}

is_valid_utf8() {
  if [ -x /system/bin/iconv ]; then
    printf '%s' "$1" | /system/bin/iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1
    return
  fi
  remaining=0
  next_min=128
  next_max=191
  for byte in $(printf '%s' "$1" | "$BUSYBOX" od -An -v -t u1); do
    if [ "$remaining" -gt 0 ]; then
      [ "$byte" -ge "$next_min" ] && [ "$byte" -le "$next_max" ] || return 1
      remaining=$((remaining - 1))
      next_min=128
      next_max=191
      continue
    fi
    if [ "$byte" -le 127 ]; then
      continue
    elif [ "$byte" -ge 194 ] && [ "$byte" -le 223 ]; then
      remaining=1
    elif [ "$byte" -eq 224 ]; then
      remaining=2; next_min=160
    elif [ "$byte" -ge 225 ] && [ "$byte" -le 236 ]; then
      remaining=2
    elif [ "$byte" -eq 237 ]; then
      remaining=2; next_max=159
    elif [ "$byte" -ge 238 ] && [ "$byte" -le 239 ]; then
      remaining=2
    elif [ "$byte" -eq 240 ]; then
      remaining=3; next_min=144
    elif [ "$byte" -ge 241 ] && [ "$byte" -le 243 ]; then
      remaining=3
    elif [ "$byte" -eq 244 ]; then
      remaining=3; next_max=143
    else
      return 1
    fi
  done
  [ "$remaining" -eq 0 ]
}

base64_encode() {
  printf '%s' "$1" | "$BUSYBOX" base64 | "$BUSYBOX" tr -d '\r\n'
}

base64_decode() {
  printf '%s' "$1" | "$BUSYBOX" base64 -d 2>/dev/null
}

base64_url_name() {
  base64_encode "$1" | "$BUSYBOX" sed 's/+/-/g; s#/#_#g; s/=*$//'
}

is_valid_pref_name() {
  value=$1
  limit=$2
  [ -n "$value" ] && [ "$(byte_length "$value")" -le "$limit" ] && is_valid_utf8 "$value"
}

is_integer_in_range() {
  value=$1
  positive_limit=$2
  negative_limit=$3
  printf '%s\n' "$value" | "$BUSYBOX" grep -Eq '^-?[0-9]+$' || return 1
  limit=$positive_limit
  digits=$value
  case "$value" in
    -*) digits=${value#-}; limit=$negative_limit ;;
  esac
  digits=$(printf '%s\n' "$digits" | "$BUSYBOX" sed 's/^0*//')
  [ -n "$digits" ] || digits=0
  [ "${#digits}" -lt "${#limit}" ] && return 0
  [ "${#digits}" -gt "${#limit}" ] && return 1
  [ "$digits" = "$limit" ] || [ "$digits" \< "$limit" ]
}

is_valid_float() {
  case "$1" in
    NaN|Infinity|-Infinity) return 0 ;;
  esac
  printf '%s\n' "$1" | "$BUSYBOX" grep -Eq '^[-+]?(([0-9]+([.][0-9]*)?)|([.][0-9]+))([eE][-+]?[0-9]+)?$' \
    || return 1
  "$BUSYBOX" awk -v value="$1" 'BEGIN {
    number = value + 0
    absolute = number < 0 ? -number : number
    if (absolute > 3.4028234663852886e38) exit 1
    if (number == 0 && value !~ /^[-+]?((0+([.]0*)?)|([.]0+))([eE][-+]?[0-9]+)?$/) exit 1
  }'
}

validate_pref_file() {
  file=$1
  expected_group=$2
  [ -f "$file" ] && [ ! -L "$file" ] || fail "preference group file is unsafe"
  size=$("$BUSYBOX" wc -c < "$file" | "$BUSYBOX" tr -d ' ')
  [ "$size" -gt 0 ] && [ "$size" -le 1048576 ] || fail "preference group exceeds 1 MiB"
  expected_header=$(printf 'ZPREFS\t1\t%s' "$expected_group")
  actual_header=$("$BUSYBOX" sed -n '1p' "$file")
  [ "$actual_header" = "$expected_header" ] || fail "preference group has an invalid header"
  "$BUSYBOX" awk -F '\t' '
    NR == 1 { next }
    NF < 3 || seen[$2]++ { exit 1 }
    $1 == "string" && NF != 3 { exit 1 }
    $1 == "string-set" && ($3 !~ /^[0-9]+$/ || NF != $3 + 3) { exit 1 }
    ($1 == "int" || $1 == "long" || $1 == "float" || $1 == "boolean") && NF != 3 { exit 1 }
    $1 != "string" && $1 != "string-set" && $1 != "int" &&
      $1 != "long" && $1 != "float" && $1 != "boolean" { exit 1 }
  ' "$file" || fail "preference group contains malformed or duplicate entries"
}

prepare_pref_context() {
  module_id=$1
  pref_group=$2
  is_valid_id "$module_id" || fail "invalid module id: $module_id"
  is_valid_pref_name "$pref_group" 128 || fail "preference group must be 1..128 UTF-8 bytes"
  read_installed_id "$module_id"
  module_data_dir="$DATA_DIR/$module_id"
  PREFS_DIR="$module_data_dir/preferences"
  [ ! -L "$module_data_dir" ] && [ ! -L "$PREFS_DIR" ] \
    || fail "module preference directory is unsafe: $module_id"
  mkdir -p "$PREFS_DIR" || fail "cannot create module preference directory"
  chmod 0700 "$module_data_dir" "$PREFS_DIR" || fail "cannot secure module preference directory"
  PREF_GROUP_ENCODED=$(base64_encode "$pref_group")
  pref_name=$(base64_url_name "$pref_group")
  PREF_FILE="$PREFS_DIR/$pref_name.prefs"
  [ ! -L "$PREF_FILE" ] || fail "preference group file is unsafe"
  if [ -e "$PREF_FILE" ]; then
    validate_pref_file "$PREF_FILE" "$PREF_GROUP_ENCODED"
  fi
}

show_pref_line() {
  line=$1
  tab=$(printf '\t')
  pref_type=${line%%"$tab"*}
  rest=${line#*"$tab"}
  encoded_key=${rest%%"$tab"*}
  rest=${rest#*"$tab"}
  key=$(base64_decode "$encoded_key") || fail "cannot decode preference key"
  printf '%s\t%s' "$pref_type" "$key"
  if [ "$pref_type" = string ]; then
    value=$(base64_decode "$rest") || fail "cannot decode string preference"
    printf '\t%s' "$value"
  elif [ "$pref_type" = string-set ]; then
    count=${rest%%"$tab"*}
    if [ "$rest" = "$count" ]; then
      rest=
    else
      rest=${rest#*"$tab"}
    fi
    printf '\t['
    index=0
    while [ "$index" -lt "$count" ]; do
      encoded_value=${rest%%"$tab"*}
      if [ "$rest" = "$encoded_value" ]; then
        rest=
      else
        rest=${rest#*"$tab"}
      fi
      value=$(base64_decode "$encoded_value") || fail "cannot decode string-set preference"
      [ "$index" -eq 0 ] || printf ', '
      printf '%s' "$value"
      index=$((index + 1))
    done
    printf ']'
  else
    printf '\t%s' "$rest"
  fi
  printf '\n'
}

check_pref_total_limit() {
  replacement=$1
  old_size=0
  [ ! -f "$PREF_FILE" ] || old_size=$("$BUSYBOX" wc -c < "$PREF_FILE" | "$BUSYBOX" tr -d ' ')
  new_size=$("$BUSYBOX" wc -c < "$replacement" | "$BUSYBOX" tr -d ' ')
  [ "$new_size" -le 1048576 ] || fail "preference group exceeds 1 MiB"
  total=0
  group_count=0
  for candidate in "$PREFS_DIR"/*.prefs; do
    [ -f "$candidate" ] && [ ! -L "$candidate" ] || continue
    total=$((total + $("$BUSYBOX" wc -c < "$candidate" | "$BUSYBOX" tr -d ' ')))
    group_count=$((group_count + 1))
  done
  if [ ! -f "$PREF_FILE" ]; then
    group_count=$((group_count + 1))
  fi
  [ "$group_count" -le 64 ] || fail "module has more than 64 preference groups"
  total=$((total - old_size + new_size))
  [ "$total" -le 4194304 ] || fail "module preferences exceed 4 MiB"
}

write_pref_file() {
  check_pref_total_limit "$PREF_TEMP_FILE"
  chmod 0600 "$PREF_TEMP_FILE" || fail "cannot secure preference group"
  "$BUSYBOX" mv "$PREF_TEMP_FILE" "$PREF_FILE" || fail "cannot atomically replace preference group"
  PREF_TEMP_FILE=
}

manage_preferences() {
  [ "$#" -ge 3 ] || fail "prefs expects a module id, group, and operation"
  module_id=$1
  pref_group=$2
  operation=$3
  shift 3

  case "$operation" in
    list|get)
      prepare_pref_context "$module_id" "$pref_group"
      if [ ! -f "$PREF_FILE" ]; then
        [ "$operation" = list ] && printf '(empty)\n' && return 0
        fail "preference group does not exist: $pref_group"
      fi
      if [ "$operation" = list ]; then
        [ "$#" -eq 0 ] || fail "prefs list takes no key"
        found=0
        while IFS= read -r line || [ -n "$line" ]; do
          case "$line" in ZPREFS*) continue ;; esac
          [ -n "$line" ] || continue
          show_pref_line "$line"
          found=1
        done < "$PREF_FILE"
        [ "$found" -eq 1 ] || printf '(empty)\n'
        return 0
      fi
      [ "$#" -eq 1 ] || fail "prefs get expects one key"
      is_valid_pref_name "$1" 512 || fail "preference key must be 1..512 UTF-8 bytes"
      encoded_key=$(base64_encode "$1")
      line=$("$BUSYBOX" awk -F '\t' -v key="$encoded_key" 'NR > 1 && $2 == key { print; found=1; exit } END { if (!found) exit 1 }' "$PREF_FILE") \
        || fail "preference key does not exist: $1"
      show_pref_line "$line"
      ;;
    set)
      [ "$#" -ge 2 ] || fail "prefs set expects a key and type"
      pref_key=$1
      pref_type=$2
      shift 2
      is_valid_pref_name "$pref_key" 512 || fail "preference key must be 1..512 UTF-8 bytes"
      encoded_key=$(base64_encode "$pref_key")
      case "$pref_type" in
        string)
          [ "$#" -eq 1 ] || fail "string preference expects exactly one value"
          [ "$(byte_length "$1")" -le 65536 ] && is_valid_utf8 "$1" \
            || fail "string preference must be valid UTF-8 within 64 KiB"
          pref_line=$(printf 'string\t%s\t%s' "$encoded_key" "$(base64_encode "$1")")
          ;;
        string-set)
          pref_line=$(printf 'string-set\t%s\t%s' "$encoded_key" "$#")
          seen_values="|"
          for value in "$@"; do
            [ "$(byte_length "$value")" -le 65536 ] && is_valid_utf8 "$value" \
              || fail "string-set item must be valid UTF-8 within 64 KiB"
            encoded_value=$(base64_encode "$value")
            case "$seen_values" in *"|$encoded_value|"*) fail "duplicate string-set value" ;; esac
            seen_values="$seen_values$encoded_value|"
            pref_line="$pref_line$(printf '\t%s' "$encoded_value")"
          done
          ;;
        int)
          [ "$#" -eq 1 ] && is_integer_in_range "$1" 2147483647 2147483648 \
            || fail "int preference is outside the signed 32-bit range"
          pref_line=$(printf 'int\t%s\t%s' "$encoded_key" "$1")
          ;;
        long)
          [ "$#" -eq 1 ] && is_integer_in_range "$1" 9223372036854775807 9223372036854775808 \
            || fail "long preference is outside the signed 64-bit range"
          pref_line=$(printf 'long\t%s\t%s' "$encoded_key" "$1")
          ;;
        float)
          [ "$#" -eq 1 ] && is_valid_float "$1" \
            || fail "float preference is invalid or outside the 32-bit range"
          pref_line=$(printf 'float\t%s\t%s' "$encoded_key" "$1")
          ;;
        boolean)
          [ "$#" -eq 1 ] && { [ "$1" = true ] || [ "$1" = false ]; } \
            || fail "boolean preference must be true or false"
          pref_line=$(printf 'boolean\t%s\t%s' "$encoded_key" "$1")
          ;;
        *) fail "unknown preference type: $pref_type" ;;
      esac
      acquire_lock
      prepare_pref_context "$module_id" "$pref_group"
      PREF_TEMP_FILE="$PREFS_DIR/.prefs.tmp.$$"
      [ ! -e "$PREF_TEMP_FILE" ] && [ ! -L "$PREF_TEMP_FILE" ] || fail "temporary preference file exists"
      printf 'ZPREFS\t1\t%s\n' "$PREF_GROUP_ENCODED" > "$PREF_TEMP_FILE" \
        || fail "cannot create temporary preference group"
      if [ -f "$PREF_FILE" ]; then
        "$BUSYBOX" awk -F '\t' -v key="$encoded_key" 'NR > 1 && $2 != key { print }' "$PREF_FILE" >> "$PREF_TEMP_FILE" \
          || fail "cannot copy preference group"
      fi
      printf '%s\n' "$pref_line" >> "$PREF_TEMP_FILE" || fail "cannot append preference value"
      write_pref_file
      printf 'Updated preference %s/%s/%s. Running targets will be notified.\n' "$module_id" "$pref_group" "$pref_key"
      ;;
    remove)
      [ "$#" -eq 1 ] || fail "prefs remove expects one key"
      pref_key=$1
      is_valid_pref_name "$pref_key" 512 || fail "preference key must be 1..512 UTF-8 bytes"
      acquire_lock
      prepare_pref_context "$module_id" "$pref_group"
      if [ ! -f "$PREF_FILE" ]; then
        printf 'Preference key not present: %s\n' "$pref_key"
        return 0
      fi
      encoded_key=$(base64_encode "$pref_key")
      if ! "$BUSYBOX" awk -F '\t' -v key="$encoded_key" 'NR > 1 && $2 == key { found=1 } END { exit !found }' "$PREF_FILE"; then
        printf 'Preference key not present: %s\n' "$pref_key"
        return 0
      fi
      PREF_TEMP_FILE="$PREFS_DIR/.prefs.tmp.$$"
      printf 'ZPREFS\t1\t%s\n' "$PREF_GROUP_ENCODED" > "$PREF_TEMP_FILE" \
        || fail "cannot create temporary preference group"
      "$BUSYBOX" awk -F '\t' -v key="$encoded_key" 'NR > 1 && $2 != key { print }' "$PREF_FILE" >> "$PREF_TEMP_FILE" \
        || fail "cannot remove preference key"
      write_pref_file
      printf 'Removed preference %s/%s/%s. Running targets will be notified.\n' "$module_id" "$pref_group" "$pref_key"
      ;;
    clear)
      [ "$#" -eq 0 ] || fail "prefs clear takes no key"
      acquire_lock
      prepare_pref_context "$module_id" "$pref_group"
      PREF_TEMP_FILE="$PREFS_DIR/.prefs.tmp.$$"
      printf 'ZPREFS\t1\t%s\n' "$PREF_GROUP_ENCODED" > "$PREF_TEMP_FILE" \
        || fail "cannot create empty preference group"
      write_pref_file
      printf 'Cleared preferences for %s/%s. Running targets will be notified.\n' "$module_id" "$pref_group"
      ;;
    *) fail "unknown prefs operation: $operation" ;;
  esac
}

show_module_info() {
  module_dir=$1
  prop_file="$module_dir/META-INF/xposed/module.prop"
  [ -s "$prop_file" ] || fail "module metadata is missing: $module_dir"
  printf 'id: %s\n' "$(get_prop "$prop_file" id)"
  printf 'name: %s\n' "$(get_prop "$prop_file" name)"
  printf 'version: %s\n' "$(get_prop "$prop_file" version)"
  printf 'versionCode: %s\n' "$(get_prop "$prop_file" versionCode)"
  printf 'author: %s\n' "$(get_prop "$prop_file" author)"
  printf 'description: %s\n' "$(get_prop "$prop_file" description)"
  printf 'minApiVersion: %s\n' "$(get_prop "$prop_file" minApiVersion)"
  printf 'targetApiVersion: %s\n' "$(get_prop "$prop_file" targetApiVersion)"
  printf 'staticScope: %s\n' "$(get_prop "$prop_file" staticScope)"
  printf 'autoHotReload: %s\n' "$(get_prop "$prop_file" autoHotReload)"
  if [ -e "$module_dir/disabled" ]; then
    printf 'status: disabled\n'
  else
    printf 'status: enabled\n'
  fi
  printf 'checksum: %s\n' "$(checksum_status "$module_dir")"
  printf 'scope:\n'
  "$BUSYBOX" sed -n '/^[[:space:]]*#/d; /^[[:space:]]*$/d; p' \
    "$module_dir/META-INF/xposed/scope.list"
}

extract_member() {
  archive=$1
  member=$2
  output=$3
  limit=$4
  "$BUSYBOX" unzip -p "$archive" "$member" 2>/dev/null \
    | "$BUSYBOX" head -c "$limit" > "$output"
  [ -s "$output" ]
}

validate_stage() {
  prop_file="$STAGE_DIR/META-INF/xposed/module.prop"
  init_file="$STAGE_DIR/META-INF/xposed/java_init.list"
  scope_file="$STAGE_DIR/META-INF/xposed/scope.list"
  [ -s "$prop_file" ] && [ -s "$init_file" ] && [ -s "$scope_file" ] \
    || fail "module ZIP is missing required metadata"

  for metadata_file in "$init_file" "$prop_file" "$scope_file"; do
    metadata_size=$("$BUSYBOX" wc -c < "$metadata_file" | "$BUSYBOX" tr -d ' ')
    [ "$metadata_size" -le 65536 ] || fail "module metadata exceeds 64 KiB"
  done
  checksum_size=$("$BUSYBOX" wc -c < "$STAGE_DIR/module.sha256" | "$BUSYBOX" tr -d ' ')
  [ "$checksum_size" -le 1024 ] || fail "module.sha256 exceeds 1 KiB"

  module_id=$(get_prop "$prop_file" id) || fail "module id is missing or duplicated"
  is_valid_id "$module_id" || fail "invalid module id: $module_id"
  module_name=$(get_prop "$prop_file" name) || fail "module name is missing or duplicated"
  module_version=$(get_prop "$prop_file" version) || fail "module version is missing or duplicated"
  module_version_code=$(get_prop "$prop_file" versionCode) || fail "versionCode is missing or duplicated"
  module_author=$(get_prop "$prop_file" author) || fail "author is missing or duplicated"
  module_description=$(get_prop "$prop_file" description) || fail "description is missing or duplicated"
  module_min_api=$(get_prop "$prop_file" minApiVersion) || fail "minApiVersion is missing or duplicated"
  module_target_api=$(get_prop "$prop_file" targetApiVersion) || fail "targetApiVersion is missing or duplicated"
  module_static_scope=$(get_prop "$prop_file" staticScope) || fail "staticScope is missing or duplicated"
  module_hot_reload=$(get_prop "$prop_file" autoHotReload) || fail "autoHotReload is missing or duplicated"

  [ -n "$module_name" ] && [ -n "$module_version" ] && [ -n "$module_author" ] \
    || fail "name, version, and author must be non-empty"
  is_positive_int "$module_version_code" || fail "versionCode must be a positive 32-bit integer"
  is_positive_int "$module_min_api" || fail "minApiVersion must be a positive integer"
  is_positive_int "$module_target_api" || fail "targetApiVersion must be a positive integer"
  [ "$module_min_api" -le 102 ] && [ "$module_target_api" -ge 102 ] \
    || fail "module API range must include API 102"
  case "$module_static_scope:$module_hot_reload" in
    true:true|true:false|false:true|false:false) ;;
    *) fail "staticScope and autoHotReload must be true or false" ;;
  esac

  init_count=0
  while IFS= read -r line || [ -n "$line" ]; do
    line=$(trim_line "$line")
    case "$line" in ''|\#*) continue ;; esac
    is_valid_class_line "$line" || fail "invalid entry class: $line"
    init_count=$((init_count + 1))
  done < "$init_file"
  [ "$init_count" -gt 0 ] || fail "java_init.list must contain an entry class"

  scope_count=0
  while IFS= read -r line || [ -n "$line" ]; do
    line=$(trim_line "$line")
    case "$line" in ''|\#*) continue ;; esac
    is_valid_scope_line "$line" || fail "invalid scope target: $line"
    scope_count=$((scope_count + 1))
  done < "$scope_file"
  [ "$scope_count" -gt 0 ] || fail "scope.list must contain at least one target"

  dex_size=$("$BUSYBOX" wc -c < "$STAGE_DIR/module.dex" | "$BUSYBOX" tr -d ' ')
  [ "$dex_size" -gt 0 ] && [ "$dex_size" -le 33554432 ] \
    || fail "module.dex must be between 1 byte and 32 MiB"
  expected=$("$BUSYBOX" awk 'NR == 1 { print $1; exit }' "$STAGE_DIR/module.sha256")
  case "$expected" in
    ''|*[!0123456789abcdefABCDEF]*) fail "module.sha256 must contain a SHA-256 digest" ;;
  esac
  [ "${#expected}" -eq 64 ] || fail "module.sha256 must contain a SHA-256 digest"
  actual_line=$("$BUSYBOX" sha256sum "$STAGE_DIR/module.dex") || fail "cannot calculate module checksum"
  actual=${actual_line%% *}
  [ "$actual" = "$expected" ] || fail "module.dex checksum does not match module.sha256"

  ARCHIVE_ID=$module_id
  ARCHIVE_VERSION=$module_version
  ARCHIVE_VERSION_CODE=$module_version_code
}

install_module() {
  [ "$#" -ge 1 ] && [ "$#" -le 2 ] || fail "install expects a ZIP path and optional --force"
  archive=$1
  force=0
  if [ "$#" -eq 2 ]; then
    [ "$2" = "--force" ] || fail "unknown install option: $2"
    force=1
  fi
  [ -f "$archive" ] || fail "module ZIP not found: $archive"
  case "$archive" in
    /*) ;;
    *) archive="$(pwd)/$archive" ;;
  esac
  "$BUSYBOX" unzip -t "$archive" >/dev/null 2>&1 || fail "module ZIP is corrupt or unreadable"
  acquire_lock
  STAGE_DIR="$MODULES_DIR/.install.$$"
  [ ! -e "$STAGE_DIR" ] || fail "temporary install path already exists"
  mkdir -p "$STAGE_DIR/META-INF/xposed" || fail "cannot create temporary install directory"

  extract_member "$archive" module.dex "$STAGE_DIR/module.dex" 33554433 \
    || fail "module ZIP is missing module.dex"
  extract_member "$archive" module.sha256 "$STAGE_DIR/module.sha256" 1024 \
    || fail "module ZIP is missing module.sha256"
  extract_member "$archive" META-INF/xposed/java_init.list "$STAGE_DIR/META-INF/xposed/java_init.list" 65537 \
    || fail "module ZIP is missing java_init.list"
  extract_member "$archive" META-INF/xposed/module.prop "$STAGE_DIR/META-INF/xposed/module.prop" 65537 \
    || fail "module ZIP is missing module.prop"
  extract_member "$archive" META-INF/xposed/scope.list "$STAGE_DIR/META-INF/xposed/scope.list" 65537 \
    || fail "module ZIP is missing scope.list"
  validate_stage

  install_target="$MODULES_DIR/$ARCHIVE_ID"
  if [ -e "$install_target" ]; then
    [ ! -L "$install_target" ] || fail "installed module directory is a symlink: $ARCHIVE_ID"
    installed_prop="$install_target/META-INF/xposed/module.prop"
    [ -s "$installed_prop" ] || fail "installed module metadata is unreadable: $ARCHIVE_ID"
    installed_version_code=$(get_prop "$installed_prop" versionCode) \
      || fail "installed module versionCode is invalid: $ARCHIVE_ID"
    is_positive_int "$installed_version_code" || fail "installed module versionCode is invalid: $ARCHIVE_ID"
    if [ "$ARCHIVE_VERSION_CODE" -lt "$installed_version_code" ] && [ "$force" -ne 1 ]; then
      fail "refusing downgrade from $installed_version_code to $ARCHIVE_VERSION_CODE; pass --force"
    fi
    if [ -e "$install_target/disabled" ]; then
      : > "$STAGE_DIR/disabled"
    fi
    BACKUP_DIR="$MODULES_DIR/.backup-$ARCHIVE_ID-$$"
    [ ! -e "$BACKUP_DIR" ] || fail "temporary backup path already exists"
    INSTALL_TARGET=$install_target
    "$BUSYBOX" mv "$install_target" "$BACKUP_DIR" || fail "cannot move the installed module"
  fi

  "$BUSYBOX" chmod 0755 "$STAGE_DIR" "$STAGE_DIR/META-INF" "$STAGE_DIR/META-INF/xposed" \
    || fail "cannot set module directory permissions"
  "$BUSYBOX" chmod 0644 "$STAGE_DIR/module.dex" "$STAGE_DIR/module.sha256" \
    "$STAGE_DIR/META-INF/xposed/java_init.list" "$STAGE_DIR/META-INF/xposed/module.prop" \
    "$STAGE_DIR/META-INF/xposed/scope.list" || fail "cannot set module file permissions"
  [ ! -e "$STAGE_DIR/disabled" ] || "$BUSYBOX" chmod 0644 "$STAGE_DIR/disabled" \
    || fail "cannot set module state permissions"
  if ! "$BUSYBOX" mv "$STAGE_DIR" "$install_target"; then
    fail "cannot activate the new module; the previous version will be restored"
  fi
  STAGE_DIR=
  if [ -n "$BACKUP_DIR" ]; then
    "$BUSYBOX" rm -rf "$BACKUP_DIR"
    BACKUP_DIR=
  fi
  INSTALL_TARGET=
  printf 'Installed %s %s (versionCode %s).\n' "$ARCHIVE_ID" "$ARCHIVE_VERSION" "$ARCHIVE_VERSION_CODE"
  printf 'Changes apply to newly started processes; running apps were not stopped.\n'
}

list_modules() {
  printf '%-32s %-16s %-10s %s\n' ID VERSION STATUS NAME
  found=0
  for module_dir in "$MODULES_DIR"/*; do
    [ -d "$module_dir" ] && [ ! -L "$module_dir" ] || continue
    module_id=${module_dir##*/}
    is_valid_id "$module_id" || continue
    prop_file="$module_dir/META-INF/xposed/module.prop"
    [ -s "$prop_file" ] || continue
    name=$(get_prop "$prop_file" name 2>/dev/null || printf '?')
    version=$(get_prop "$prop_file" version 2>/dev/null || printf '?')
    status=enabled
    [ ! -e "$module_dir/disabled" ] || status=disabled
    printf '%-32s %-16s %-10s %s\n' "$module_id" "$version" "$status" "$name"
    found=1
  done
  [ "$found" -eq 1 ] || printf '(no modules installed)\n'
}

remove_module() {
  [ "$#" -eq 1 ] || fail "remove expects a module id"
  module_id=$1
  read_installed_id "$module_id"
  acquire_lock
  if [ -e "$DATA_DIR/$module_id" ]; then
    [ -d "$DATA_DIR/$module_id" ] && [ ! -L "$DATA_DIR/$module_id" ] \
      || fail "module data directory is unsafe: $module_id"
  fi
  "$BUSYBOX" rm -rf "$MODULES_DIR/$module_id" || fail "could not remove $module_id"
  if [ -e "$DATA_DIR/$module_id" ]; then
    "$BUSYBOX" rm -rf "$DATA_DIR/$module_id" || fail "could not remove data for $module_id"
  fi
  printf 'Removed %s.\n' "$module_id"
  printf 'Changes apply to newly started processes; running apps were not stopped.\n'
}

set_module_enabled() {
  [ "$#" -eq 1 ] || fail "$COMMAND expects a module id"
  module_id=$1
  read_installed_id "$module_id"
  acquire_lock
  if [ "$COMMAND" = disable ]; then
    : > "$MODULES_DIR/$module_id/disabled" || fail "could not disable $module_id"
    "$BUSYBOX" chmod 0644 "$MODULES_DIR/$module_id/disabled"
    printf 'Disabled %s.\n' "$module_id"
  else
    [ ! -e "$MODULES_DIR/$module_id/disabled" ] \
      || "$BUSYBOX" rm -f "$MODULES_DIR/$module_id/disabled" \
      || fail "could not enable $module_id"
    printf 'Enabled %s.\n' "$module_id"
  fi
  printf 'Changes apply to newly started processes; running apps were not stopped.\n'
}

COMMAND=${1:-help}
shift 2>/dev/null || true
case "$COMMAND" in
  help|-h|--help)
    usage
    ;;
  version|--version)
    printf 'zygisk_framework CLI 0.4.0\n'
    ;;
  install)
    install_module "$@"
    ;;
  list)
    [ "$#" -eq 0 ] || fail "list takes no arguments"
    list_modules
    ;;
  info)
    [ "$#" -eq 1 ] || fail "info expects a module id"
    module_id=$1
    read_installed_id "$module_id"
    show_module_info "$MODULES_DIR/$module_id"
    ;;
  scope)
    manage_scope "$@"
    ;;
  prefs)
    manage_preferences "$@"
    ;;
  remove)
    remove_module "$@"
    ;;
  enable|disable)
    set_module_enabled "$@"
    ;;
  *)
    usage >&2
    fail "unknown command: $COMMAND"
    ;;
esac
